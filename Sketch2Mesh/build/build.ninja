  CONFIG = release
  LANGUAGE_COMPILE_FLAGS = -O3 -DNDEBUG
  OBJECT_DIR = imgui\CMakeFiles\imgui.dir
  POST_BUILD = cd .
  PRE_LINK = cd .
  TARGET_COMPILE_PDB = imgui\CMakeFiles\imgui.dir\imgui.pdb
  TARGET_FILE = imgui\libimgui.a
  TARGET_PDB = imgui\libimgui.pdb


